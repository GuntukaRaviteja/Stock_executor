# Application Settings
APP_NAME=Stock Intelligence API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Market Data Provider (mock / alphavantage / yfinance)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=10.0

# News Data Provider (mock / newsapi)
NEWS_DATA_PROVIDER=mock
NEWS_DATA_API_KEY=
NEWS_DATA_TIMEOUT_SECONDS=10.0

# Security / CORS
CORS_ORIGINS=["*"]
