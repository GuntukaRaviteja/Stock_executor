# Application Settings
APP_NAME=Stock Intelligence API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Market Data Provider (mock / alphavantage / yfinance)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=10.0

# News Data Provider (mock / newsapi)
NEWS_DATA_PROVIDER=mock
NEWS_DATA_API_KEY=
NEWS_DATA_TIMEOUT_SECONDS=10.0

# Security / CORS
CORS_ORIGINS=["*"]

# Phase 9 Paper Trading Defaults (SIMULATION ONLY — no brokerage is ever contacted)
# Commission charged per side as a fraction of gross value (0.001 = 0.1%)
PAPER_TRADING_COMMISSION_RATE=0.001
# Minimum fee per side; 0 means only the percentage applies
PAPER_TRADING_MIN_FEE=0
# Fractional slippage applied adversely to the fill price; 0 fills at the requested price
PAPER_TRADING_SLIPPAGE_RATE=0
# Strategy entry budget as a percentage of available cash
PAPER_TRADING_POSITION_SIZE_PCT=10
# Risk limits; leave empty to disable the corresponding rule
PAPER_TRADING_MAX_POSITION_QUANTITY=
PAPER_TRADING_MAX_POSITION_VALUE=
PAPER_TRADING_MAX_POSITION_ALLOCATION_PCT=
PAPER_TRADING_MAX_DRAWDOWN_PCT=

# Phase 10 Risk Management and Paper-Trading Engine Defaults
# These are application-wide fallbacks. Every limit can also be set per portfolio, and the
# per-portfolio value always wins. An empty value disables the rule.
# Share of portfolio equity that may be invested across all positions at once
PAPER_TRADING_MAX_EXPOSURE_PCT=
# Share of portfolio equity a single trade may commit
PAPER_TRADING_MAX_TRADE_ALLOCATION_PCT=
# Share of equity that must stay in cash; a BUY breaching it is rejected
PAPER_TRADING_MIN_CASH_RESERVE_PCT=
# Maximum number of stocks held at once
PAPER_TRADING_MAX_POSITIONS=
# Default fill convention for historical replays:
#   OPEN  = signal at the close of bar N, fill at the OPEN of bar N+1 (Phase 8 convention)
#   CLOSE = signal and fill at the close of bar N
PAPER_TRADING_EXECUTION_PRICE_POLICY=OPEN
# Annual risk-free rate used for the Sharpe ratio, in percent (India: ~7%)
PAPER_TRADING_RISK_FREE_RATE_PCT=0

# Phase 12 Daily Loss & Trade-Size Defaults
# An empty value disables the rule, which is the default: a portfolio that was audited under
# Phase 9-11 must keep behaving exactly as it did.
# Share of the day's opening equity that may be lost before the day is closed to new BUYs.
# Measured against the day's opening equity, so a deposit does not count as a gain and does
# not reset the allowance. A SELL is never blocked: a loss limit must not trap a position.
PAPER_TRADING_MAX_DAILY_LOSS_PCT=
# Smallest order the engine will accept, in the portfolio's currency. Dust orders are usually
# a rounding artefact or a mis-scaled price, and each one still pays a fee.
PAPER_TRADING_MIN_TRADE_VALUE=
# ISO 4217 code stamped on a portfolio at creation and carried through every money field in
# every portfolio response. Three uppercase letters; not validated against a currency list.
PAPER_TRADING_DEFAULT_CURRENCY=INR

# Phase 11 Portfolio Construction & Risk Management Defaults
# These are the application-wide fallbacks for the *construction policy*. They are stored per
# portfolio in `allocation_config_json` on first use, so changing one here does not rewrite a
# portfolio that already has a stored configuration. An empty value disables that rule.
#
# How the portfolio is built
# How a target weight becomes a share count: EQUAL_WEIGHT, RISK_BASED or MAX_POSITION_CAP
PORTFOLIO_ALLOCATION_SIZING_METHOD=EQUAL_WEIGHT
# Largest share of equity any one position may hold
PORTFOLIO_MAX_POSITION_WEIGHT_PCT=20
# Largest share of equity any one sector may hold; empty means no sector cap
PORTFOLIO_MAX_SECTOR_WEIGHT_PCT=
# Maximum number of stocks held at once; empty means no cap
PORTFOLIO_MAX_POSITIONS=
# Largest share of equity that may be invested across all positions; empty means no cap
PORTFOLIO_MAX_EXPOSURE_PCT=
# Largest tolerated loss in a single position, in percent; empty means no limit
PORTFOLIO_MAX_POSITION_LOSS_PCT=
# Share of equity held back in cash and never committed to a position
PORTFOLIO_CASH_RESERVE_PCT=10
# Smallest target value worth opening a position for; empty means any size is allowed
PORTFOLIO_MIN_POSITION_VALUE=

# How risk is acted on
# Loss from entry that triggers a SELL recommendation, in percent; empty means no stop
PORTFOLIO_STOP_LOSS_PCT=
# Gain from entry that triggers a REDUCE recommendation, in percent; empty means no target
PORTFOLIO_TAKE_PROFIT_PCT=
# Loss one trade may put at risk, as a percent of equity; the RISK_BASED sizing budget
PORTFOLIO_RISK_PER_TRADE_PCT=1

# Phase 13 — portfolio & risk management engine
# See docs/phase-13.md. All three are optional: an empty value means the limit is off.
# Largest decline from peak equity tolerated before the drawdown flag is raised, in percent.
# Note: unlike the concentration limits, the drawdown guard fires *at* the limit, not beyond it.
PORTFOLIO_MAX_DRAWDOWN_PCT=
# Share of equity that may sit at risk to the stops of all open positions combined, in percent
PORTFOLIO_MAX_TOTAL_RISK_PCT=
# Smallest gross trade value the engine will propose; below it no position is opened
PORTFOLIO_MIN_TRADE_VALUE=

# Phase 15 — portfolio-level risk, stress testing and exposure control
# See docs/phase-15.md. Every limit here is a percentage of portfolio equity unless stated.
# An empty value disables that rule; it does not mean "zero tolerance".
#
# Concentration limits
# Largest share of equity one position may represent
PORTFOLIO_RISK_MAX_SINGLE_ASSET_WEIGHT=20
# Largest share of equity one sector may represent
PORTFOLIO_RISK_MAX_SECTOR_WEIGHT=35
# Largest share of equity one strategy may represent
PORTFOLIO_RISK_MAX_STRATEGY_WEIGHT=50
# Largest share of equity one asset class may represent
PORTFOLIO_RISK_MAX_ASSET_CLASS_WEIGHT=
# Combined weight of the largest N positions
PORTFOLIO_RISK_MAX_TOP_N_CONCENTRATION=60
# How many largest positions the top-N rule looks at
PORTFOLIO_RISK_TOP_N_COUNT=10
#
# Risk metric limits
# Maximum annualised portfolio volatility, in percent
PORTFOLIO_RISK_MAX_VOLATILITY=30
# Maximum portfolio beta against the benchmark
PORTFOLIO_RISK_MAX_BETA=1.50
# Maximum historical peak-to-trough drawdown, in percent
PORTFOLIO_RISK_MAX_DRAWDOWN=25
# Maximum weighted average pairwise correlation across the book
PORTFOLIO_RISK_MAX_CORR_CONCENTRATION=60
#
# Stress scenario magnitudes, as positive percentages
# Broad-market decline used by the broad crash scenario
PORTFOLIO_RISK_MARKET_CRASH_SHOCK=20
# Broad-market decline used by the severe crash scenario
PORTFOLIO_RISK_SEVERE_CRASH_SHOCK=30
# Decline applied to the targeted sector
PORTFOLIO_RISK_SECTOR_SHOCK=25
# Base decline for the high-beta scenario before the beta tilt
PORTFOLIO_RISK_HIGH_BETA_SHOCK=10
# Extra decline per unit of beta above the market's
PORTFOLIO_RISK_HIGH_BETA_TILT=10
# Decline applied to the largest strategy
PORTFOLIO_RISK_STRATEGY_SHOCK=20
# Extra haircut applied to illiquid positions, in percent
PORTFOLIO_RISK_LIQUIDITY_HAIRCUT=5
# Blend of each off-diagonal correlation toward 1.0 (0-1); higher means less diversification
PORTFOLIO_RISK_CORRELATION_SPIKE_MULTIPLIER=0.30
# Multiplier applied to each off-diagonal volatility
PORTFOLIO_RISK_CORRELATION_SPIKE_VOL_MULTIPLIER=1.20
# Largest estimated loss tolerated under any single scenario
PORTFOLIO_RISK_MAX_STRESS_LOSS=20
#
# Liquidity
# Minimum portfolio liquidity score (0-100); empty disables the rule
PORTFOLIO_RISK_MIN_LIQUIDITY_SCORE=
# Largest position value / average daily traded value, as a fraction (0-1]
PORTFOLIO_RISK_MAX_PARTICIPATION_RATIO=0.20
#
# Position counts; empty disables the rule
PORTFOLIO_RISK_MIN_POSITION_COUNT=
PORTFOLIO_RISK_MAX_POSITION_COUNT=
#
# Evaluation policy
# Utilization, as a percent of a limit, at which a metric is reported as WARNING
PORTFOLIO_RISK_WARNING_UTILIZATION=80
# Periods per year used to annualise volatility from daily returns
PORTFOLIO_RISK_ANNUALIZATION_PERIODS=252
# Overlapping return observations required before covariance and risk metrics are computed
PORTFOLIO_RISK_MIN_OBSERVATIONS=30
# Return observations required before historical VaR and Expected Shortfall are computed
PORTFOLIO_RISK_MIN_VAR_OBSERVATIONS=10
# Correlation at or above which two positions are treated as one risk cluster
PORTFOLIO_RISK_CORR_CLUSTER_THRESHOLD=0.75
# Benchmark symbol used for beta when a request does not name one
PORTFOLIO_RISK_BENCHMARK_SYMBOL=
#
# Historical VaR and Expected Shortfall
# Confidence level for the historical quantile
PORTFOLIO_RISK_VAR_CONFIDENCE=0.95
# Holding period of the VaR figure, in days
PORTFOLIO_RISK_VAR_HORIZON_DAYS=1
#
# Risk budgets — optional consumption targets; empty disables the budget
PORTFOLIO_RISK_BUDGET_ASSET_CONC=
PORTFOLIO_RISK_BUDGET_SECTOR_CONC=
PORTFOLIO_RISK_BUDGET_STRATEGY_CONC=
PORTFOLIO_RISK_BUDGET_VOLATILITY=
PORTFOLIO_RISK_BUDGET_BETA=
PORTFOLIO_RISK_BUDGET_DRAWDOWN=
PORTFOLIO_RISK_BUDGET_VAR=
PORTFOLIO_RISK_BUDGET_STRESS=
#
# Limits whose breach rejects rather than adjusts. A breach of any other limit is corrected
# deterministically by the reduction loop.
PORTFOLIO_RISK_MANDATORY_LIMITS=max_single_asset_weight,max_sector_weight,max_strategy_weight,max_portfolio_volatility,max_drawdown,max_stress_loss
# Largest number of reduction passes the adjustment loop may take
PORTFOLIO_RISK_MAX_ADJUSTMENT_PASSES=12
# Set false to report breaches without proposing any reduction
PORTFOLIO_RISK_ENABLE_ADJUSTMENT=true
# Set true to skip the stress catalogue entirely
PORTFOLIO_RISK_DISABLE_STRESS_TESTS=false

# How often the portfolio is corrected
# Weight drift tolerated before a rebalance trade is proposed, in percent
PORTFOLIO_REBALANCE_THRESHOLD_PCT=0.5
